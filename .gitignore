# --- runtime state, never in the repo -----------------------------------------
# data/ is the server's, not the release's: the database, the settings this
# installation has changed, the deploy credentials, the update backups. The rule
# is a blanket one rather than a list of names, because the next thing written
# there will not be on the list.
data/*
!data/.htaccess
INVITE-CODE.txt

# --- secrets ----------------------------------------------------------------
.env
*.pem
*.ppk
deploy.local.*
.deploy/
ftp-credentials*

# --- editors / OS -----------------------------------------------------------
.idea/
.vscode/
*.iml
Thumbs.db
.DS_Store
desktop.ini

# --- scratch ----------------------------------------------------------------
node_modules/
*.log
.cf-tmp/

# --- graphify knowledge graph artifacts -------------------------------------
graphify-out/

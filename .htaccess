Options -Indexes
DirectoryIndex index.html

# ---------------------------------------------------------------- file types
# Belt and braces: works even when mod_rewrite is unavailable, and on the hosts
# where a deny in a subdirectory .htaccess is silently ignored. `zip` is here
# because an update stores the version it replaced as one, under data/; nothing
# CourseForge serves is a zip. `.php` deliberately is NOT here - the application
# is made of PHP files - which is why an update backup is a single archive
# rather than a live tree of executable files.
<FilesMatch "\.(sqlite|sqlite3|db|db-wal|db-shm|json|md|log|ini|txt|zip|tar|gz|bak|sql|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Under CGI/FastCGI Apache drops the Authorization header before PHP sees
    # it, which would make every MCP request look unauthenticated.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Never serve anything out of the private directories. config/ has its own
    # .htaccess as well, and tests/ is here because a release ships it and a
    # test file is a PHP file, which the FilesMatch above deliberately does not
    # cover - the application is made of those.
    RewriteRule ^(data|src|tools|config|tests)/ - [F,L]

    # The MCP endpoint is its own front door: bearer token instead of a cookie
    # session, JSON-RPC instead of REST. It has to be excluded before the
    # catch-all below, which would otherwise hand it to the browser API.
    RewriteRule ^api/mcp\.php$ - [L]
    RewriteRule ^mcp/?$        api/mcp.php [QSA,L]

    # Everything else under /api/ goes through the single front controller.
    RewriteRule ^api/?$    api/index.php [QSA,L]
    RewriteRule ^api/(.+)$ api/index.php [QSA,L]
</IfModule>

# --------------------------------------------------------------------- types
# Some servers do not know .mjs yet; without this the module fails to load.
<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType image/svg+xml .svg
</IfModule>

# ------------------------------------------------------------------- headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
</IfModule>

# --------------------------------------------------------------------- cache
# There is no build step, so no file is ever renamed when its contents change:
# assets/js/App.js is that path in every release. Cache-busting is therefore
# done in the URL instead - `tools/assets.php` stamps `?v=<version>` onto every
# asset index.html references, and `core/assets.js` does the same for the three
# libraries whose names are decided at runtime.
#
# That is what makes the year below honest: `App.js?v=4.4.1` really cannot
# change. Without it the promise is a lie that a browser has no way to catch,
# and `immutable` is honoured through a reload and a hard reload alike - which
# is how 4.4.0 reached people as new application code running against the
# previous release's Vue and Shiki.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|mjs|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # index.html is the one file that must never be held: it carries the import
    # map, and therefore the version stamp that every other URL is built from.
    # A stale copy of this pins a visitor to a release they have already
    # upgraded away from, and nothing else can rescue them - so it is
    # revalidated every time. That costs one conditional request answered by a
    # 304 of a couple of hundred bytes.
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# --------------------------------------------------------------- compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
